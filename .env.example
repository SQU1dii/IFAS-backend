# ───────────────────────────────────────────────────────────
# IFAS Backend environment variables
# Copy to .env and fill in. NEVER commit real secrets.
# ───────────────────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed CORS origins (the frontend origin(s))
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (MySQL 8). Used by Knex in production.
DB_CLIENT=mysql2
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ifas
DB_USER=ifas
DB_PASSWORD=ifas_password
DB_CONNECTION_LIMIT=10

# Tests run on an in-memory SQLite DB when DB_CLIENT_TEST=sqlite3.
# No external database required for the test suite.
DB_CLIENT_TEST=sqlite3

# Auth / JWT
# Access tokens are short-lived and stateless; refresh tokens are hashed + stored.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# Analytics service (Python FastAPI). The Node API is the only thing that
# calls it; it never touches the database. Point ANALYTICS_SERVICE_URL at the
# FastAPI service. Leave blank to use the built-in mock for local testing.
ANALYTICS_SERVICE_URL=http://127.0.0.1:8001
ANALYTICS_TIMEOUT_MS=15000
ANALYTICS_MAX_RETRIES=2
# When set to "mock" the Node API uses the in-process mock analytics client.
ANALYTICS_MODE=mock

# External AI provider for the assistant. Only AGGREGATED figures are sent.
# AI_PROVIDER_URL is an OpenAI-compatible chat completions endpoint.
AI_PROVIDER_URL=http://127.0.0.1:8002/v1/chat/completions
AI_PROVIDER_API_KEY=change-me-ai-provider-key
AI_PROVIDER_MODEL=ifas-assistant
AI_TIMEOUT_MS=30000
# When set to "mock" the Node API uses the in-process mock AI client.
AI_MODE=mock

# Logging
LOG_LEVEL=info
